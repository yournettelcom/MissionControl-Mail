# =============================================================================
# MissionControl Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Database
DATABASE_URL=mysql+aiomysql://missioncontrol:YOUR_DB_PASSWORD@127.0.0.1:3306/missioncontrol

# JWT
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Paths
POSTFIX_CONFIG_DIR=/etc/postfix
DOVECOT_CONFIG_DIR=/etc/dovecot
VMAIL_DIR=/var/vmail

# API
API_TITLE=MissionControl API
API_VERSION=1.0.0

# CORS — restrict to your domain in production
CORS_ORIGINS=["http://localhost", "http://YOUR_DOMAIN"]
