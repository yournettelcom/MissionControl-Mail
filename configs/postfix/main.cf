smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

inet_protocols = all
smtp_address_preference = ipv6
smtp_bind_address6 = ::1
smtp_bind_address = PLACEHOLDER_SERVER_IP

myhostname = mail.example.com
mydomain = mail.example.com
myorigin = $mydomain
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8 [::1]/128 PLACEHOLDER_NETWORK
relayhost =
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks permit_sasl_authenticated reject_unauth_destination

smtpd_sasl_auth_enable = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth

smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332
milter_default_action = accept
milter_protocol = 6
compatibility_level = 3.6
virtual_mailbox_maps = hash:/etc/postfix/virtual_domains
virtual_alias_maps = hash:/etc/postfix/virtual
smtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file = /etc/postfix/ssl-cert-snakeoil.key
smtpd_use_tls = yes
smtpd_tls_security_level = may
smtpd_tls_session_cache_database = btree:/var/lib/postfix/smtpd_tls_session_cache
smtp_tls_security_level = may
smtp_tls_session_cache_database = btree:/var/lib/postfix/smtp_tls_session_cache
